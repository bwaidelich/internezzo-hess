# Master locations are rendered as virtual sub pages of Internezzo.HessBus:Document.Locations
# (see Internezzo\HessMaster\Routing\LocationAwareFrontendNodeRoutePartHandler), so this site needs a
# rendering prototype for them.
prototype(Internezzo.HessMaster:Document.Location) < prototype(Internezzo.HessBus:Document.AbstractPage) {
  # The location node is not part of this site, so the main menu must not be derived from its rootline.
  # Start at the site node and highlight this site's Locations document as active item instead.
  body.menu {
    startingPoint = ${site}
    @context.activeNode = ${q(site).children('[instanceof Internezzo.HessMaster:Mixin.LocationsOverview]').get(0)}
  }
  body.content >
  body.content = ${'Hess BUS: ' + q(node).property('title')}
}
