# Location reference documents are regular documents of this site underneath Internezzo.HessMaster:Mixin.LocationsOverview.
# They are created automatically according to the "sites" property of the master locations and contain the translated
# properties of the master location in the language of the document
# (see Internezzo\HessMaster\Service\LocationReferenceSynchronizer).
# Language independent properties can be read from the master location.
prototype(Internezzo.HessMaster:Document.LocationReference) < prototype(Internezzo.HessBus:Document.AbstractPage) {
  @context.locationNode = ${Internezzo.HessMaster.Location.master(node)}

  body.content >
  body.content = Neos.Fusion:Case {
    location {
      condition = ${locationNode != null}
      renderer = Neos.Fusion:Component {
        title = ${q(node).property('title')}
        renderer = afx`
          <h1>{props.title}</h1>
        `
      }
    }
    missing {
      condition = true
      renderer = afx`<p>Der referenzierte Standort ist nicht verfügbar.</p>`
    }
  }
}
