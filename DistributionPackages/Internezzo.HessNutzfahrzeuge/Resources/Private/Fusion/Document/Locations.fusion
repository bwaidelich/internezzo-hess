prototype(Internezzo.HessNutzfahrzeuge:Document.Locations) < prototype(Internezzo.HessNutzfahrzeuge:Document.AbstractPage) {
  body.content >
  body.content = Neos.Fusion:Component {
    # The reference documents of the master locations (see Internezzo\HessMaster\Service\LocationReferenceSynchronizer)
    locations = ${q(node).children('[instanceof Internezzo.HessMaster:Document.LocationReference]').get()}

    renderer = afx`
      <h2>Hess Nutzfahrzeuge Standorte:</h2>
      <ul>
        <Neos.Fusion:Loop items={props.locations} itemName="locationNode">
          <li>
            <Neos.Neos:NodeLink node={locationNode} />
          </li>
        </Neos.Fusion:Loop>
      </ul>
    `

    # The list depends on the reference documents underneath this document, so changes there have to flush this page
    @cache {
      mode = 'cached'
      entryIdentifier {
        node = ${Neos.Caching.entryIdentifierForNode(node)}
      }
      entryTags {
        1 = ${Neos.Caching.nodeTag(node)}
        2 = ${Neos.Caching.descendantOfTag(node)}
      }
    }
  }
}
